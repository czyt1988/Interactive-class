# 环境：dev / prod
ENV=dev

# 站点信息
SITE_TITLE=AI Learning
SITE_URL=http://127.0.0.1:8000
COURSE_BASE_URL=/courses

# 片头/片尾：模板库目录，以及片头里印的开源项目地址。
# 每门课用哪个片头/片尾在后台选择，保存在数据库的 course_clips 表（不进 Git）。
CLIPS_DIR=clips
PROJECT_URL=https://gitee.com/czyt1988/interactive-class

# 课程源与构建产物。Web 进程只读 COURSES_DIST_DIR。
COURSES_SRC_DIR=courses
COURSES_DIST_DIR=dist/courses

# 数据层
DATABASE_URL=sqlite:///./data/app.db

# 目录与部署开关
STRICT_CATALOG=0
INCLUDE_DRAFTS=1
VERIFY_COURSE_BUNDLES=1
SESSION_COOKIE_SECURE=0

# 课程导入：外部课程文件夹放进收件箱，由 scripts/import_course.py 或 /import 页面导入。
# 课程内容仍然写入 files（courses/<slug>/），数据库只登记来源（course_imports）。
# /import 页面默认只在 dev 开放。
COURSES_INBOX_DIR=course-inbox
COURSE_IMPORT_ENABLED=1

# 后台视频生成（可选）。产物在 data/videos/，不进 Git。
VIDEO_OUTPUT_DIR=data/videos
VIDEO_WORK_DIR=data/videos/.work
VIDEO_QUALITY=looks
VIDEO_RENDER_TIMEOUT_SECONDS=7200
# 留空时自动发现：指定的 CLI -> 仓库 tools/ -> PATH -> npx
VIDEO_HYPERFRAMES_CLI=
VIDEO_HYPERFRAMES_VERSION=0.9.19
VIDEO_NODE_BIN=node
VIDEO_NPX_BIN=npx
VIDEO_FFMPEG_DIR=

# 后台管理密码。留空表示后台不设防；部署到公网前务必设置。
ADMIN_TOKEN=
