# git 工作树（scripts/worktree.py 创建，不进版本库）
/.worktree/

# Python 虚拟环境与缓存
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
大纲/

# 构建产物与运行时数据
/dist/
/data/
renders/
*.db
*.sqlite3

# 视频与渲染产物：课程本身是 HTML 静态包，视频只是本地导出结果，不进版本库
*.mp4
*.webm
*.mov
*.mkv
*.avi
*.m4v
*.flv
*.wmv

# Windows 启动脚本的运行状态与临时文件
/.run/
/.tmp/
*.log

# 第三方运行时：由 scripts/sync_runtime.py 生成，见 runtime/VERSION.json
/runtime/vendor/

# Node / HyperFrames 创作工具
node_modules/
.hyperframes/

# 导入收件箱：作者把外部生成的课程文件夹放在这里，由 scripts/import_course.py 或 /import 页面导入
/course-inbox/

# 本地配置（.env.example 需要提交）
.env

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# 课程创作缓存：旁白 TTS 源文件、快照与渲染产物都不进版本库
courses/*/narration/cache/
courses/*/composition/.snaps-*/
courses/*/composition/.review-*/
courses/*/composition/.thumbnails/
courses/*/renders/

# 浏览器测试产物
test-results/
playwright-report/

# 本地视频导出工具（ffmpeg / ffprobe，由开发机自行安装）
tools/ffmpeg/
